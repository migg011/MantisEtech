FROM node:24-bookworm-slim AS frontend
WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/angular.json frontend/tsconfig*.json ./
COPY frontend/src/ ./src/
RUN npm run build -- --configuration production

FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DJANGO_DEBUG=false
WORKDIR /app
COPY backend/requirements.lock.txt ./
RUN pip install --no-cache-dir -r requirements.lock.txt whitenoise==6.12.0
COPY backend/manage.py ./
COPY backend/download_image_model.py ./
RUN python download_image_model.py
COPY backend/config/ ./config/
COPY backend/maintenance/ ./maintenance/
COPY --from=frontend /build/dist/mantis/browser /app/frontend
RUN useradd --create-home mantis
USER mantis
EXPOSE 10000
CMD ["python", "-m", "config.demo_start"]
