%% Gerado do catálogo físico. PK = chave primária; FK = referência a outra tabela.
erDiagram
    setores {
        int8 id PK
        varchar codigo
        varchar nome
        text descricao
        bool ativo
        timestamptz criado_em
    }
    linhas {
        int8 id PK
        varchar codigo
        varchar nome
        text descricao
        bool ativo
        timestamptz criado_em
        int8 setor_id
    }
    tipos_equipamento {
        int2 id PK
        varchar nome
    }
    equipamentos {
        int8 id PK
        varchar numero_modelo
        varchar modelo
        varchar numero_serie
        varchar fabricante
        date data_fabricacao
        varchar data_fabricacao_texto
        numeric comprimento_mm
        numeric largura_mm
        numeric altura_mm
        numeric peso_kg
        numeric tensao_v
        numeric frequencia_hz
        numeric corrente_a
        numeric potencia_w
        numeric pressao_pneumatica_bar
        varchar numero_patrimonio
        text descricao
        text descricao_processo
        int4 posicao
        bool ativo
        timestamptz criado_em
        int2 tipo_equipamento_id
        int8 linha_id
        int8 setor_id
        varchar nome
    }
    usuarios {
        int8 id PK
        timestamptz ultimo_acesso
        varchar nome
        varchar matricula
        text senha_hash
        varchar perfil
        bool ativo
        timestamptz criado_em
        int8 linha_id
    }
    anexos_equipamento {
        int8 id PK
        varchar categoria
        varchar nome_arquivo
        varchar tipo_mime
        bytea conteudo
        int4 tamanho_bytes
        timestamptz criado_em
        int8 equipamento_id
        int8 enviado_por_id
    }
    movimentacoes_equipamento {
        int8 id PK
        int4 posicao_origem
        int4 posicao_destino
        varchar acao
        timestamptz criado_em
        int8 equipamento_id
        int8 executado_por_id
        int8 linha_origem_id
        int8 linha_destino_id
    }
    roteiros_preventiva {
        int8 id PK
        varchar periodicidade
        jsonb itens
        int2 tipo_equipamento_id
    }
    agendas_preventiva {
        int8 id PK
        varchar periodicidade
        date proximo_vencimento
        date ultima_execucao
        bool ativo
        int8 equipamento_id
        jsonb itens_roteiro
    }
    ordens_preventiva {
        int8 id PK
        varchar situacao
        date vencimento_previsto
        date data_planejada
        time hora_planejada
        varchar base_recorrencia
        varchar periodicidade
        jsonb retrato_equipamento
        jsonb itens
        jsonb resultados
        text instrucoes_seguranca
        jsonb pecas
        text observacoes
        date data_execucao
        time hora_execucao
        varchar nome_responsavel
        timestamptz criado_em
        varchar nome_executor
        timestamptz concluido_em
        text motivo_cancelamento
        int4 revisao
        int8 responsavel_id
        int8 criado_por_id
        int8 concluido_por_id
        int8 agenda_id
    }
    execucoes_preventiva {
        int8 id PK
        date data_execucao
        date vencimento_anterior
        date proximo_vencimento
        text observacoes
        timestamptz criado_em
