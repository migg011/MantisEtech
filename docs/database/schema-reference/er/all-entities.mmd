        int8 tecnico_id
        int8 ordem_preventiva_id
    }
    tipos_problema {
        int8 id PK
        varchar nome
        varchar prioridade
        bool ativo
        int2 tipo_equipamento_id
    }
    ordens_servico {
        int8 id PK
        varchar prioridade
        varchar situacao
